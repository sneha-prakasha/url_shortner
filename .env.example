# Copy this file to ".env" and change the values:   cp .env.example .env

MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=snip
MYSQL_USER=snip
MYSQL_PASSWORD=change-me-db-password

# Signs login tokens. Use a long random value, e.g.:  openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# The public address people use to open the app. Short links are built from it.
#   local:  http://localhost:8080
#   AWS:    http://<your-ec2-public-ip>   (and set WEB_PORT=80)
BASE_URL=http://localhost:8080
WEB_PORT=8080
